# Environment Variables SIP PT Handoko Bangkit Jaya
# Supabase Configuration (Hanya URL dan Anon Key yang boleh NEXT_PUBLIC_)

# 1. Supabase Project URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anonymous Public Key (Client & Server - Terikat RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Supabase Service Role Key (SERVER-SIDE ONLY - Bypass RLS untuk Admin/Server Action)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. Kredensial Admin & Sesi Server (SERVER-SIDE ONLY - DILARANG DIBERI PREFIX NEXT_PUBLIC_)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$10$r6lwXTjeXOsTcWyUAxMygOR7Bvt52h4zWOuZ5.bqoj3wOrveS4xgi'
SESSION_SECRET=hbj-sip-super-secure-jwt-secret-key-32-chars-minimum-2026
